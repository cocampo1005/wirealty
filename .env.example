# Copy to .env.local for local development. Never commit real secrets.

# Public site origin, used for canonical URLs, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://wirealty.us

# Sample content (development fixtures, draft portfolio records, unapproved
# testimonials, placeholder slots). Defaults to ON in `next dev` and OFF in
# production builds. Set to "true" only for private previews / staging —
# never on the public website.
# NEXT_PUBLIC_SHOW_SAMPLE_CONTENT=true

# --- Inquiry email delivery (server-side only) -------------------------------
# Forms report an explicit "not configured" state until these are set.
# Provider: Resend (https://resend.com) HTTP API.
RESEND_API_KEY=
# Verified sender, e.g. "Weston International Realty <website@wirealty.us>"
INQUIRY_FROM_EMAIL=
# Where inquiries are delivered. Defaults to the address in src/content/business.ts
INQUIRY_TO_EMAIL=
